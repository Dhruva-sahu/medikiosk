# --- Server ---
APP_NAME=MediKiosk
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Supabase PostgreSQL (transaction mode / port 6543 pooler):
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Local PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/medikiosk
DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480

# --- AI ---
# AI_MODE=mock uses deterministic, safe clinical structuring with no external calls.
# AI_MODE=live requires an AI_PROVIDER (openai, gemini, anthropic) and corresponding API key.
AI_MODE=mock
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- OCR ---
# OCR_PROVIDER=mock returns deterministic text for any document so the demo always works.
# OCR_PROVIDER=tesseract uses pytesseract and requires a system Tesseract binary.
OCR_PROVIDER=mock

# --- Speech ---
# SPEECH_PROVIDER=mock returns deterministic transcripts.
# SPEECH_PROVIDER=whisper uses OpenAI Whisper; requires OPENAI_API_KEY.
# SPEECH_PROVIDER=bhashini for Indian-language ASR (placeholder, requires BHASHINI_API_KEY).
SPEECH_PROVIDER=mock
BHASHINI_API_KEY=

# --- ABDM / FHIR / HIS ---
# All three default to deterministic mock implementations that emit realistic FHIR R4 JSON.
ABDM_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
FHIR_BASE_URL=
HIS_BASE_URL=

# --- Storage ---
UPLOAD_DIR=./uploads/documents
MAX_UPLOAD_BYTES=10485760
